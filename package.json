{
	"name": "@keros3ne/studio-sdk",
	"version": "0.15.3",
	"description": "Build games for KEROS3NE: how a game's outcomes are made into books, the client's bridge to the site, the stage, the control bar and controls, Storybook, the site's own checks, and keros3ne-studio, the command line to make a game's books, check it and play it. Clone it to start a studio.",
	"license": "MIT",
	"type": "module",
	"private": true,
	"//": "Private so that it is never published to a registry: a studio clones this repository, and the site takes it at a git tag.",
	"bin": {
		"keros3ne-studio": "./sdk/cli.ts"
	},
	"exports": {
		"./maths": "./sdk/maths.ts",
		"./guide": "./sdk/guide.ts",
		"./events": "./sdk/events.ts",
		"./manifest": "./sdk/manifest.ts",
		"./studio-folder": "./sdk/studio-folder.ts",
		"./rng": "./sdk/rng.ts",
		"./limits": "./sdk/limits.ts",
		"./bets": "./sdk/bets.ts",
		"./book": "./sdk/book.ts",
		"./book-check": "./sdk/book-check.ts",
		"./book-files": "./sdk/book-files.ts",
		"./book-game": "./sdk/book-game.ts",
		"./book-maker": "./sdk/book-maker.ts",
		"./book-pack": "./sdk/book-pack.ts",
		"./book-play": "./sdk/book-play.ts",
		"./book-report": "./sdk/book-report.ts",
		"./book-round": "./sdk/book-round.ts",
		"./book-weights": "./sdk/book-weights.ts",
		"./game-manifest": "./sdk/game-manifest.ts",
		"./kero": "./sdk/kero.ts",
		"./slots": "./sdk/slots.ts",
		"./stake-steps": "./sdk/stake-steps.ts",
		"./stories": "./sdk/stories.ts",
		"./labels": "./sdk/labels.ts",
		"./pixi": "./sdk/pixi/index.ts",
		"./slot": "./sdk/slot/index.ts",
		"./emitter": "./sdk/emitter.svelte.ts",
		"./protocol": "./sdk/protocol.ts",
		"./host": "./sdk/host.ts",
		"./frame": "./sdk/frame.ts",
		"./client": "./sdk/client.ts",
		"./ui": "./sdk/ui.ts",
		"./bar": "./sdk/bar.ts",
		"./bar-rules": "./sdk/bar-rules.ts",
		"./loading": "./sdk/loading.ts",
		"./loading-look": "./sdk/loading-look.ts",
		"./client-build": "./sdk/client-build.ts",
		"./client-pack": "./sdk/client-pack.ts",
		"./controls": "./sdk/controls/index.ts",
		"./testing": "./sdk/testing.ts",
		"./verify": "./sdk/verify.ts",
		"./stand-in": "./sdk/stand-in.ts",
		"./ui.css": "./sdk/ui.css",
		"./bar.css": "./sdk/bar.css",
		"./loading.css": "./sdk/loading.css"
	},
	"scripts": {
		"books": "bun sdk/cli.ts books",
		"client": "bun sdk/cli.ts client",
		"check": "bun sdk/cli.ts check",
		"dev": "bun sdk/cli.ts dev harbour-lights",
		"stories": "bun sdk/cli.ts stories",
		"test": "bun --bun vitest --run",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:browser": "bun --bun playwright install chromium && bun --bun playwright test",
		"pack": "bun sdk/cli.ts pack"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@noble/hashes": "^2.4.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.4.0",
		"@storybook/svelte-vite": "^10.6.7",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"pixi.js": "^8.23.0",
		"storybook": "^10.6.7"
	},
	"peerDependencies": {
		"svelte": "^5.57.2",
		"valibot": "^1.5.0",
		"vite": "^8.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@types/bun": "^1.4.4",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"playwright": "^1.60.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"valibot": "^1.5.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	}
}
